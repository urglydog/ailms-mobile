# URL gọi tới backend Spring Boot — bắt buộc tiền tố EXPO_PUBLIC_ (quy ước Expo cho biến
# env dùng ở client, tương đương NEXT_PUBLIC_ của web).
#
# QUAN TRỌNG: khác với web (chạy trong browser trên cùng máy với backend lúc dev), app mobile
# chạy trên ĐIỆN THOẠI THẬT (qua Expo Go) nên "localhost" sẽ trỏ về chính điện thoại, KHÔNG
# phải máy dev — không dùng http://localhost:8080 được. Dùng 1 trong 2 cách:
#   1. Domain backend thật đã deploy (vd https://api.your-domain.com) — đơn giản nhất, dùng
#      luôn khi backend đã lên server.
#   2. Nếu backend chỉ chạy local lúc dev: dùng IP LAN của máy dev (vd http://192.168.1.x:8080,
#      điện thoại và máy dev phải cùng mạng Wi-Fi) hoặc 1 tunnel (ngrok/cloudflared) để lộ ra
#      ngoài internet tạm thời.
EXPO_PUBLIC_API_URL=https://your-backend-domain.example.com
